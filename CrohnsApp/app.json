{
  "expo": {
    "name": "CrohnsApp",
    "slug": "CrohnsApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "crohnsapp",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "CrohnsApp needs your camera to scan food barcodes."
        }
      ]
    ],
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.crohnsapp.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "INTERNET",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": ""
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "038cc841-4f87-4a30-a0c9-867726dbeab9"
      }
    },
    "owner": "seanleblanc"
  }
}
